{
  "schema": 1,
  "name": "fake",
  "version": "0.1.0",
  "nouns": [
    {"name": "app", "verbs": [{"name": "quit", "description": "Exit", "kind": "interaction"}]},
    {"name": "item", "verbs": [
      {"name": "list", "description": "List the items", "kind": "application", "result": "row[]"},
      {"name": "remove", "description": "Remove an item", "kind": "application", "confirm": "Remove {{label}}?"},
      {"name": "touch", "description": "Touch an item and report it", "kind": "application", "params": {"note": {"type": "string", "source": "item.list"}}}
    ]},
    {"name": "tool", "verbs": [
      {"name": "echo", "description": "Echo the text", "kind": "application", "params": {"text": {"type": "string", "required": true}, "voice": {"type": "string", "source": "tool.voices"}}},
      {"name": "ping", "description": "Answer pong", "kind": "application"},
      {"name": "voices", "description": "List the voices", "kind": "application"}
    ]},
    {"name": "projects", "verbs": [
      {"name": "list", "description": "List the projects", "kind": "application", "result": "row[]", "rows": "project"}
    ]},
    {"name": "project", "verbs": [
      {"name": "open", "description": "Open a project", "kind": "application"}
    ]},
    {"name": "field", "pin": "insert", "verbs": [
      {"name": "submit", "description": "Submit the field", "kind": "application"}
    ]}
  ],
  "bindings": [
    {"noun": "app", "keys": "ctrl+c", "request": {"verb": "quit", "noun": "app"}},
    {"noun": "item", "mode": "normal", "keys": "x", "request": {"verb": "remove", "noun": "item"}},
    {"noun": "item", "mode": "normal", "keys": "t", "request": {"verb": "touch", "noun": "item"}},
    {"noun": "item", "mode": "normal", "keys": "j", "request": {"verb": "touch", "noun": "item"}},
    {"noun": "tool", "mode": "normal", "keys": "p", "request": {"verb": "ping", "noun": "tool"}},
    {"noun": "project", "mode": "normal", "keys": "o", "request": {"verb": "open", "noun": "project"}}
  ],
  "pages": []
}
