#!/bin/sh
# A fake extension for nabe's tests. State lives in $FAKE_STATE: items (one
# "id name" line per item) and calls (one line per invocation's arguments).
# FAKE_MODE=fail makes catalog fail; FAKE_MODE=schema2 answers schema 2;
# FAKE_MODE=state answers a catalog with a state source (item state).
dir=$(dirname "$0")
state=${FAKE_STATE:?FAKE_STATE is not set}
echo "$*" >>"$state/calls"
target=
prev=
for arg in "$@"; do
	[ "$prev" = "--target" ] && target=$arg
	prev=$arg
done
case "$1 $2" in
"catalog ")
	case "${FAKE_MODE:-}" in
	fail) echo "catalog broke" >&2; exit 3 ;;
	schema2) sed 's/"schema": 1/"schema": 2/' "$dir/fake-catalog.json"; exit 0 ;;
	state)
		# A state source: item state answers item and projects in one call.
		sed -e 's/"version": "0.1.0",/"version": "0.1.0", "state": "item.state",/' \
			-e 's/{"name": "list", "description": "List the items"/{"name": "state", "description": "Every list", "kind": "application", "params": {"fresh": {"type": "boolean"}}},\n      &/' \
			"$dir/fake-catalog.json"
		exit 0
		;;
	esac
	cat "$dir/fake-catalog.json"
	;;
"item list")
	sep=
	printf '['
	while read -r id name; do
		printf '%s{"id":"%s","name":"%s"}' "$sep" "$id" "$name"
		sep=,
	done <"$state/items"
	printf ']\n'
	;;
"item state")
	# JSON Lines tagged by noun, with a malformed line in the middle: the
	# host skips it and loses nothing else.
	n=0
	while read -r id name; do
		printf '{"noun":"item","id":"%s","label":"%s"}\n' "$id" "$name"
		n=$((n + 1))
		[ $n -eq 1 ] && printf '{"noun":"item","id":\n'
	done <"$state/items"
	printf '{"noun":"projects","id":"p1","label":"pone"}\n'
	;;
"item touch") printf '{"touched":"%s"}\n' "$target" ;;
"item remove")
	grep -v "^$target " "$state/items" >"$state/items.new"
	mv "$state/items.new" "$state/items"
	printf '{"removed":"%s"}\n' "$target"
	;;
"tool ping") echo '{"pong":true}' ;;
"tool voices") echo '["loud","soft"]' ;;
"projects list") echo '[{"id":"p1","name":"pone"}]' ;;
"project open") printf '{"opened":"%s"}\n' "$target" ;;
"tool echo") echo "$4" ;;
*) echo "fake: unknown command $*" >&2; exit 1 ;;
esac
